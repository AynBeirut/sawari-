# ============================================================
#  Sawari — Environment Variables
#  Copy this to .env and fill in real values:
#    cp .env.example .env
#    nano .env
# ============================================================

# JWT secret — use a long random string (min 32 chars)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# Admin password for login.html
ADMIN_PASS=CHANGE_THIS_TO_YOUR_PASSWORD

# Server port (default 3000 — matches Apache vhost config)
PORT=3000

# ── Optional: Email alerts on new lead submissions ────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# NOTIFY_EMAIL=sales@sawari.com
